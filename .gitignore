:root {
  font-family: 'Cairo', sans-serif;
  color: #edf3ff;
  background: #070d1d;
  line-height: 1.5;
  font-weight: 400;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

* {
  box-sizing: border-box;
}

html, body, #root {
  margin: 0;
  min-width: 100%;
  min-height: 100%;
  background:
    radial-gradient(circle at top, rgba(32, 115, 255, 0.2), transparent 35%),
    linear-gradient(135deg, #040b16 0%, #0b1322 50%, #09111d 100%);
}

body {
  min-height: 100vh;
  color: #edf3ff;
}

button {
  font: inherit;
  cursor: pointer;
}

.app-shell {
  display: flex;
  min-height: 100vh;
  padding: 24px;
  gap: 24px;
}

.sidebar {
  width: 280px;
  background: rgba(10, 17, 31, 0.9);
  border: 1px solid rgba(125, 160, 255, 0.16);
  border-radius: 24px;
  padding: 24px 18px;
  box-shadow: 0 20px 40px rgba(6, 11, 21, 0.45);
}

.brand {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 8px 10px 24px;
  border-bottom: 1px solid rgba(150, 170, 210, 0.14);
}

.brand-mark {
  width: 46px;
  height: 46px;
  border-radius: 14px;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, #3a8cff, #62d5ff);
  color: #03121d;
  font-weight: 800;
}

.brand h1 {
  margin: 0;
  font-size: 1.4rem;
}

.brand span {
  color: #8dd5ff;
  font-size: 0.8rem;
  letter-spacing: 2px;
}

.nav {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 22px;
}

.nav-item {
  border: 0;
  background: rgba(146, 170, 255, 0.04);
  color: #dfe9ff;
  text-align: right;
  padding: 12px 14px;
  border-radius: 12px;
  transition: 0.2s ease;
}

.nav-item.active,
.nav-item:hover {
  background: linear-gradient(135deg, rgba(56, 115, 255, 0.3), rgba(92, 201, 255, 0.12));
  box-shadow: inset 0 0 0 1px rgba(107, 171, 255, 0.2);
}

.mini-card {
  margin-top: 28px;
  padding: 18px 14px;
  border-radius: 16px;
  background: rgba(11, 27, 45, 0.85);
  border: 1px solid rgba(136, 167, 255, 0.18);
}

.mini-label {
  color: #9ebaf3;
  font-size: 0.82rem;
  margin-bottom: 12px;
}

.mini-status {
  display: flex;
  align-items: center;
  gap: 8px;
  font-weight: 600;
}

.dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  display: inline-block;
}

.dot-live {
  background: #47ff9c;
  box-shadow: 0 0 12px rgba(71, 255, 156, 0.75);
}

.mini-card small {
  display: block;
  margin-top: 10px;
  color: #8fa7d1;
}

.main-panel {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 22px;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  padding: 8px 8px 0;
}

.eyebrow {
  margin: 0;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color: #8cb1ff;
  font-size: 0.72rem;
}

.topbar h2 {
  margin: 8px 0 0;
  font-size: clamp(1.8rem, 2vw, 2.5rem);
}

.top-actions {
  display: flex;
  gap: 12px;
}

.primary-btn,
.secondary-btn,
.text-btn {
  border: 0;
  border-radius: 12px;
  padding: 12px 18px;
  font-weight: 700;
}

.primary-btn {
  background: linear-gradient(135deg, #316dff, #55d7ff);
  color: #061120;
}

.secondary-btn {
  background: rgba(141, 171, 255, 0.08);
  color: #edf3ff;
  border: 1px solid rgba(140, 169, 255, 0.2);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(180px, 1fr));
  gap: 18px;
}

.stat-card {
  background: rgba(10, 17, 31, 0.84);
  border: 1px solid rgba(127, 158, 236, 0.16);
  border-radius: 18px;
  padding: 18px 18px 16px;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03);
}

.stat-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14px;
  color: #bfd4ff;
  font-size: 0.8rem;
}

.delta {
  color: #7dffb3;
  font-weight: 700;
}

.stat-card strong {
  font-size: clamp(1.4rem, 2vw, 2.2rem);
}

.content-grid,
.bottom-grid {
  display: grid;
  grid-template-columns: 1.6fr 1fr;
  gap: 20px;
}

.panel {
  background: rgba(9, 16, 29, 0.9);
  border: 1px solid rgba(132, 162, 245, 0.12);
  border-radius: 22px;
  padding: 18px 18px 16px;
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18px;
}

.panel-header h3 {
  margin: 0;
  font-size: 1.1rem;
}

.text-btn {
  background: transparent;
  color: #8bb6ff;
  padding: 0;
}

.incident-table {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.table-head,
.table-row {
  display: grid;
  grid-template-columns: 1.4fr 0.9fr 0.8fr 0.75fr;
  gap: 12px;
  align-items: center;
}

.table-head {
  color: #7d90b9;
  font-size: 0.75rem;
  padding: 0 8px 10px;
  text-transform: uppercase;
}

.table-row {
  padding: 12px 8px;
  border-radius: 12px;
  background: rgba(18, 28, 46, 0.82);
  border: 1px solid rgba(132, 172, 255, 0.08);
}

.incident-main {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.incident-main small {
  color: #a6bfdc;
}

.badge,
.risk,
.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  padding: 6px 10px;
  font-size: 0.72rem;
  font-weight: 700;
  width: fit-content;
}

.badge.blocked,
.risk.high,
.risk.critical,
.chip-live {
  background: rgba(255, 92, 92, 0.15);
  color: #ff8d8d;
}

.badge.investigating,
.risk.medium {
  background: rgba(255, 198, 68, 0.14);
  color: #ffc76c;
}

.badge.monitoring,
.risk.low {
  background: rgba(88, 194, 255, 0.12);
  color: #8ed5ff;
}

.badge.resolved {
  background: rgba(84, 255, 170, 0.12);
  color: #7fffc2;
}

.score-box {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4px;
}

.score-box small {
  color: #93aacc;
}

.score {
  display: inline-flex;
  width: 42px;
  justify-content: center;
  border-radius: 10px;
  font-weight: 800;
  padding: 6px 0;
}

.score.critical { background: rgba(255, 90, 90, 0.18); color: #ff9696; }
.score.high { background: rgba(255, 162, 80, 0.16); color: #ffb36f; }
.score.medium { background: rgba(255, 212, 90, 0.14); color: #ffe18d; }
.score.low { background: rgba(90, 255, 176, 0.15); color: #77ffd5; }

.alert-list {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.alert-item {
  display: flex;
  gap: 12px;
  padding: 12px 10px;
  border-radius: 12px;
  background: rgba(17, 25, 42, 0.78);
  border: 1px solid rgba(141, 170, 255, 0.08);
}

.alert-icon {
  width: 28px;
  height: 28px;
  border-radius: 10px;
  display: grid;
  place-items: center;
  color: #ffed9c;
  background: rgba(255, 197, 63, 0.12);
  font-weight: 900;
}

.alert-item h4 {
  margin: 0 0 6px;
  font-size: 0.96rem;
}

.alert-item p {
  margin: 0;
  color: #b8c7e7;
  font-size: 0.82rem;
}

.meta-row {
  display: flex;
  justify-content: space-between;
  margin-top: 8px;
  color: #7d97cb;
  font-size: 0.72rem;
}

.threat-map {
  display: grid;
  gap: 12px;
}

.region-card {
  padding: 12px 14px;
  border-radius: 12px;
  background: rgba(15, 23, 37, 0.8);
  border: 1px solid rgba(159, 182, 255, 0.1);
}

.region-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6px;
}

.region-card p {
  margin: 0;
  color: #b7cbef;
}

.summary-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.summary-list div {
  display: flex;
  justify-content: space-between;
  padding: 12px 14px;
  border-radius: 12px;
  background: rgba(15, 23, 37, 0.82);
  border: 1px solid rgba(152, 178, 255, 0.1);
}

.summary-list span {
  color: #aac2f0;
}

.summary-list strong {
  font-size: 0.96rem;
}

@media (max-width: 1080px) {
  .app-shell {
    flex-direction: column;
  }

  .sidebar {
    width: 100%;
  }

  .content-grid,
  .bottom-grid,
  .stats-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 620px) {
  .app-shell {
    padding: 14px;
  }

  .topbar {
    flex-direction: column;
    align-items: flex-start;
  }

  .table-head {
    display: none;
  }

  .table-row {
    grid-template-columns: 1fr 1fr;
  }

  .score-box {
    align-items: flex-start;
  }
}
